# Copiez ce fichier en .env. Ne publiez jamais le fichier .env réel.
PORT=5177
HOST=127.0.0.1

# Origine publique locale utilisée par le serveur et pour la protection CSRF.
APP_ORIGIN=http://localhost:5177

BETASERIES_API_KEY=
BETASERIES_CLIENT_SECRET=

# Doit aussi être déclarée comme URL de redirection dans votre application BetaSeries.
BETASERIES_REDIRECT_URI=http://localhost:5177/callback

# La documentation BetaSeries demande une version >= 3.0.
BETASERIES_API_VERSION=3.0

# Limites de sécurité optionnelles (millisecondes et octets).
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_BYTES=65536
MAX_RESPONSE_BYTES=5242880
